# Środowisko: development | production
PT_ENVIRONMENT=production

# Adres i port backendu REST API (lokalnie zawsze 127.0.0.1; w Dockerze 0.0.0.0)
PT_API_HOST=0.0.0.0
PT_API_PORT=8765

# Token autoryzacyjny API (w produkcji ustaw długi losowy ciąg znaków!)
PT_API_TOKEN=change-me-to-a-long-random-secret

# Baza danych:
# Domyślnie lokalny SQLite; dla VPS/Docker odkomentuj PostgreSQL:
# PT_DATABASE_URL=postgresql+asyncpg://price_tracker:strong_password@postgres:5432/price_tracker

# Harmonogram i limity współbieżności
PT_DEFAULT_CHECK_INTERVAL_SECONDS=3600
PT_MAX_CONCURRENT_HTTP_CHECKS=6
PT_MAX_CONCURRENT_BROWSER_CHECKS=2
PT_JOB_HISTORY_RETENTION_DAYS=30

# Logi (DEBUG | INFO | WARNING | ERROR)
PT_LOG_LEVEL=INFO

# Powiadomienia Telegram Bot API (opcjonalnie przez ENV na serwerze Linux/Docker)
# PT_SECRET_TELEGRAM_BOT_TOKEN=123456789:AAH_your_bot_token_here
